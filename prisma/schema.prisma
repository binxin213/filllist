generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model RepairRequest {
  id              Int      @id @default(autoincrement())
  applicant       String
  serialNumber    String
  location        String
  applicationTime DateTime
  projectName     String
  description     String
  expectedReturn  DateTime
  createdAt       DateTime @default(now())
}
